# Neon PostgreSQL — obtenelo en console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Brevo — obtenelo en app.brevo.com > SMTP & API > API Keys
BREVO_API_KEY=xkeysib-...

# Email desde donde sale la notificación (debe estar verificado en Brevo)
FROM_EMAIL=noreply@adoops.ai

# Email que recibe los leads
NOTIFY_EMAIL=hola@adoops.ai

# =============================================================================
# Demo "Reportes de Terreno" — WhatsApp (WaSender) → IA → dashboard (/terreno)
# =============================================================================

# WaSender — https://wasenderapi.com (API Keys del número conectado)
WASENDER_API_KEY=
# Secreto opcional para verificar la firma del webhook (header x-webhook-signature)
WASENDER_WEBHOOK_SECRET=

# OpenAI — transcripción (Whisper) Y extracción estructurada (function calling)
OPENAI_API_KEY=sk-...

# Z.AI (GLM) — si está configurada, el DJ asistente / Mix eterno usa GLM-5.2
# vía la API OpenAI-compatible de api.z.ai (docs.z.ai). Tiene prioridad sobre
# OPENAI_API_KEY para las sugerencias. Modelo alternativo: SUGGEST_MODEL.
# Por defecto pega al endpoint del GLM Coding Plan (suscripción). Para pago
# por uso: ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_API_KEY=
ZAI_BASE_URL=
# Modelo de transcripción (opcional)
STT_MODEL=gpt-4o-transcribe
# Modelo de extracción (opcional). Para más calidad: gpt-4o
EXTRACT_MODEL=gpt-4o-mini

# =============================================================================
# TV Mix — mixer de YouTube sincronizado con TV (/mix + /tv) — ver docs/tv-mix.md
# =============================================================================

# YouTube Data API v3 (opcional) — habilita el buscador visual sin conectar cuenta.
# console.cloud.google.com > APIs y servicios > Credenciales > Clave de API
YOUTUBE_API_KEY=

# OAuth de Google (opcional) — conecta la cuenta de YouTube / YouTube Music del
# usuario (sus playlists y "Me gusta"). Crear cliente OAuth "Aplicación web" en
# console.cloud.google.com con redirect URI: https://www.adoops.digital/api/mix/auth/callback
# (con www — el apex redirige a www y Google exige la URI exacta; agregar
# también http://localhost:3000/api/mix/auth/callback para desarrollo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secreto para sellar la cookie de tokens (opcional; si falta se deriva del
# client secret). Generar con: openssl rand -hex 32
MIX_AUTH_SECRET=

# =============================================================================
# CRM comercial (/crm) — ver docs/crm.md
# =============================================================================

# Firma de la cookie de sesión del CRM. Mínimo 32 caracteres.
# Generar con: openssl rand -hex 32
# Sin esta variable el CRM responde 500 en vez de dejar entrar.
CRM_SESSION_SECRET=

# Números autorizados a recibir WhatsApp cuando el modo simulado está apagado
# (E.164 sin '+', separados por coma). Vacía = no sale ningún mensaje.
CRM_WHATSAPP_ALLOWLIST=

# Protege /api/crm/cron/alertas (recálculo automático de la bandeja).
CRON_SECRET=

# Modelo que redacta los resúmenes del CRM (opcional; por defecto glm-5.2 con
# ZAI_API_KEY, o gpt-4o-mini con OPENAI_API_KEY).
CRM_NARRADOR_MODEL=

# =============================================================================
# Dashboard360 (/dashboard360) — ver docs/dashboard360.md
# =============================================================================

# Firma de la cookie de sesión del tablero. Mínimo 32 caracteres.
# Generar con: openssl rand -hex 32
# Sin esta variable /dashboard360 responde 500 en vez de dejar entrar.
D360_SESSION_SECRET=

# Modelo que redacta el informe al directorio (opcional; por defecto glm-5.2
# con ZAI_API_KEY, o gpt-4o-mini con OPENAI_API_KEY).
D360_NARRADOR_MODEL=

# Protege /api/dashboard360/cron/setup, que crea las tablas y siembra el demo
# dentro del despliegue. Generar con: openssl rand -hex 32
# Sin esta variable el endpoint responde 503 — y borrarla es la forma de
# apagarlo cuando el demo ya no se regenera.
D360_SETUP_SECRET=

# Credenciales de la cuenta de demostración que crea ese endpoint.
# Por defecto: demo / dashboard360
D360_DEMO_USER=
D360_DEMO_PASS=

# =============================================================================
# Ingesta de Google Ads (/api/dashboard360/cron/google-ads)
# Ver docs/dashboard360-google-ads.md para cómo se obtiene cada uno.
# =============================================================================

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Cuenta que se va a leer, sin guiones. La API rechaza el formato 123-456-7890.
GOOGLE_ADS_CUSTOMER_ID=

# Solo si el acceso pasa por una cuenta de administrador (camino B). Con acceso
# de usuario directo se deja vacía: enviarla sin que el MCC administre la cuenta
# produce USER_PERMISSION_DENIED.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# =============================================================================
# Máquina de contenido (/dashboard360/contenido) — publicar en LinkedIn por API
# Ver docs/verificacion-share-on-linkedin.md y docs/runbook-linkedin-app.md
# =============================================================================

# App del portal de desarrolladores de LinkedIn, creada bajo la página de la
# empresa que opera los perfiles. Necesita los dos productos de autoservicio:
# "Sign in with LinkedIn using OpenID Connect" y "Share on LinkedIn".
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# En la pestaña Auth de la app hay que registrar la URL de retorno EXACTA.
# LinkedIn exige HTTPS, URL absoluta, sin '#' y sin parámetros:
#   https://www.adoops.digital/api/linkedin/callback
# Con 'www' — el apex redirige y LinkedIn compara el string, no el destino.
# Para desarrollo, agregar también la de localhost si el portal la acepta.

# El header Linkedin-Version caduca cada ~12 meses (la 202508 se apagó el
# 17-08-2026). Sin esta variable se usa la que está fijada en
# lib/contenido/linkedin.ts. Sirve para subirla sin desplegar.
LINKEDIN_API_VERSION=

# =============================================================================
# Sistema Tuniche (/tuniche) — ver docs/sistema_funcional/README.md
# =============================================================================

# Firma de la cookie de sesión del sistema de Semillas Tuniche. Mínimo 32
# caracteres. Generar con: openssl rand -hex 32
#
# Es un secreto DISTINTO al del CRM y al del tablero, y tiene que seguir
# siéndolo: /tuniche no es un producto de adoOps, es el sistema interno de otra
# empresa alojado en esta infraestructura. Compartir el secreto significaría que
# una sesión de adoOps abre los datos de los agricultores de Tuniche.
#
# Sin esta variable /tuniche responde 500 en vez de dejar entrar.
TUNICHE_SESSION_SECRET=

# El número de WhatsApp al que los zonales le mandan sus audios es
# +56 9 2257 6899 (la cuenta conectada en WaSender). No va como variable —el
# sistema responde por la cuenta, no por el número— y se anota acá porque es lo
# primero que alguien pregunta.
#
# Ese es el número RECEPTOR. El de cada usuario en `tuniche_usuarios.telefono`
# es el EMISOR: desde qué teléfono manda sus audios esa persona.
#
# El webhook entrante es /api/whatsapp/webhook, compartido con las demos de
# TorreControl y protegido por WASENDER_WEBHOOK_SECRET. Tuniche no tiene webhook
# propio: adentro se bifurca por el número de quien escribe.

# Corre todo el flujo de Tuniche sin mandar ningún WhatsApp: se transcribe, se
# estructura y se guarda, pero la respuesta se registra en consola. Solo para
# desarrollo — en producción esta variable NO va.
TUNICHE_WHATSAPP_SIMULADO=
